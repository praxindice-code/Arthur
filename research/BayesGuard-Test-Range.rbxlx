						<string name="Name">ControlScript</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7a1d89bb9207a8c40acfb3af0000094f</UniqueId>
					</Properties>
